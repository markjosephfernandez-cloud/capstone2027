CI_ENVIRONMENT = production

# Use the public directory as your virtual host document root in production.
app.baseURL = 'https://greyhound.example.edu/'
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = last_fm
database.default.username = change_me
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.port = 3306

# This must be a non-public, writable directory mounted to the media volume.
greyhound.storageRoot = 'C:/media/greyhound'
greyhound.departmentStorageRoot = 'C:/media/greyhound-departments'
# Comma-separated existing storage mounts. Only database paths inside these
# roots can be accessed while historical records are being migrated.
greyhound.legacyStorageRoots = 'C:/media/legacy-greyhound'
# 0 removes the per-file application limit. Large web uploads use small chunks.
greyhound.maxUploadBytes = 0
# Optional absolute executable paths; otherwise video previews search PATH and common install directories.
# greyhound.ffmpegBinary = 'C:/ffmpeg/bin/ffmpeg.exe'
# greyhound.ffprobeBinary = 'C:/ffmpeg/bin/ffprobe.exe'
# Files placed here are copied (never moved) into File Management by iFound.
greyhound.scanSourceRoot = 'C:/media/greyhound-scan-inbox'
# Optional origin label for a mounted network scan source. The scanner reads
# the local mounted path above; it does not open AFP URLs directly.
greyhound.scannerEndpoint = ''
greyhound.scanDestination = 'iFound Scanned Files'
greyhound.maxScanFiles = 10000
greyhound.scanBatchSize = 10
greyhound.tokenHours = 12
# Local ConvNeXt service; start greyhound-hub-2.0/start-ai-server.sh first.
greyhound.eventModelEndpoint = 'http://127.0.0.1:5001/predict'
# Do not use * when bearer tokens are accepted from browsers.
greyhound.corsOrigins = 'https://admin.example.edu'

# Optional separate visual AI endpoint. Defaults to /analyze on the event model service.
# greyhound.visualModelEndpoint = http://127.0.0.1:5001/analyze
