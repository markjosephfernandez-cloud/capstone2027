CI_ENVIRONMENT = production

# Use the public directory as your virtual host document root in production.
app.baseURL = 'https://greyhound.example.edu/'
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = last_fm
database.default.username = change_me
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
database.default.port = 3306

# This must be a non-public, writable directory mounted to the media volume.
greyhound.storageRoot = 'C:/media/greyhound'
# Comma-separated existing storage mounts. Only database paths inside these
# roots can be accessed while historical records are being migrated.
greyhound.legacyStorageRoots = 'C:/media/legacy-greyhound'
greyhound.maxUploadBytes = 104857600
greyhound.tokenHours = 12
# Do not use * when bearer tokens are accepted from browsers.
greyhound.corsOrigins = 'https://admin.example.edu'
